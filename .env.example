# Copy to .env for local dev, or export directly. Never commit the real key.
# cp .env.example .env
#
# VOYAGER_KEY: ASU AIR (Voyager) API key for AI planning + photo recognition.
#   - Required for meal plans and photo recognition.
#   - Get one from your ASU AIR / Voyager account, then set VOYAGER_KEY=key-here
#   - On Vercel, set it under Project settings > Environment Variables instead.
VOYAGER_KEY=
# Tavily discovery key for live recipe search. Recipe pages are then fetched
# directly with a browser-safe impit client and verified from Recipe JSON-LD.
# Required for meal planning; there is no static or model-invented recipe fallback.
TAVILY_API_KEY=
# Advertised grocery offers need no search key: Walmart is read directly,
# ALDI comes from its storefront API, and Fry's uses the Kroger credentials
# below when set. Prices are advertised web prices; pickup is never confirmed.
# Optional direct-read tuning. WALMART_BROWSERS is a comma list of impit
# fingerprints tried in order (default chrome151,chrome142,ios18; those three
# pass from Vercel, older profiles do not). WALMART_WARMUP=1 visits Walmart's
# homepage before each search when the WAF starts demanding cookies.
WALMART_BROWSERS=
WALMART_WARMUP=
# Optional Kroger Public API credentials (free at developer.kroger.com).
# With these set, Fry's prices come from the official Products API at the
# nearest Tempe store. Limits are 10,000 product calls and 1,600 location
# calls per day per app, and tokens last 30 minutes.
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=
# Defaults below work for most teammates — leave them unless told otherwise.
ASU_AIR_BASE_URL=https://openai.rc.asu.edu/v1
ASU_AIR_MODEL=llama4-scout-17b
ASU_AIR_VISION_MODEL=qwen3-vl-32b-instruct
# Defaults to ASU_AIR_MODEL; override only if a different multimodal verifier is tested.
ASU_AIR_VISION_VERIFY_MODEL=llama4-scout-17b
PORT=3000
